  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "node --test tests/*.test.js",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "sync",
    "team-collaboration"
  ],
  "author": "Ottomate",
  "homepage": "https://synkk.ottomate.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tawandajosephmutsena/synk-obsidian-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/tawandajosephmutsena/synk-obsidian-plugin/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "0.20.0",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "^5.3.3"
  }
}
